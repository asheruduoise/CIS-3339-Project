# Frontend configuration (committed for grading - course project values only).
# Vite reads these at BUILD time. Rebuild after changing them.

# Base URL of the backend API. No trailing slash.
VITE_ROOT_API=http://localhost:3000

# Sprint 2: true = use the in-browser mock API in src/mock/ (no backend needed).
# Sprint 3: set to false once the real backend implements S1/B1/B2.
VITE_USE_MOCKS=true
