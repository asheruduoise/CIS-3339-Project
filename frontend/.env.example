# Copy to .env and fill in. Vite reads these at build time.

# Base URL of the backend API (no trailing slash), e.g. https://your-api.onrender.com
VITE_ROOT_API=http://localhost:3000

# true = in-browser mock API (src/mock/), false = real backend
VITE_USE_MOCKS=false

# Optional: only if the site is served from a sub-path, e.g. /app/
# VITE_BASE=/
